{
  "schema_version": 2,
  "basis": "ROM/save/engine evidence first; no guessed content-count ceilings",
  "persistent_id_contract": {
    "minimum_width_bits": 16,
    "none_id": 0,
    "reserved_invalid_id": 65535,
    "allocation": "append-only",
    "renumber_existing_ids": false,
    "removed_ids": "tombstone",
    "runtime_compaction_allowed_only_with_explicit_translation": true
  },
  "species_form_model": {
    "representation": "composite",
    "fields": [
      "species_id",
      "form_id"
    ],
    "minimum_species_id_width_bits": 16,
    "minimum_form_id_width_bits": 16,
    "battle_only_forms_use_same_canonical_model": true,
    "parameterized_visual_variants_may_use_parameters_instead_of_consuming_global_ids": true
  },
  "namespace_policy": {
    "fixed_preallocated_generation_sized_tables": false,
    "hardcoded_generation_count_as_abi": false,
    "derive_runtime_counts_from_imported_registry": true,
    "capacity_numbers_before_engine_audit": "forbidden",
    "audit_required_namespaces": [
      "species",
      "forms",
      "moves",
      "abilities",
      "items",
      "types",
      "natures",
      "evolution_methods",
      "trainer_classes",
      "maps",
      "flags",
      "vars",
      "music",
      "sound_effects"
    ]
  },
  "next_gate": {
    "name": "engine-width-and-save-space-audit",
    "required_before_assigning_content-capacity-numbers": true
  }
}
